PORT=3000
LIFECARDS_DB_PATH=./data/lifecards.sqlite
# Production-intent default. Lower this only in local demos/tests if you need to see the event.
LIFECARDS_LUCA_DENOMINATOR=1000000000
LIFECARDS_HOLO_RATE=0.075

# Catalogue of Life import. Defaults to the official latest Base Release DwCA.
# COL_DWCA_URL=https://download.checklistbank.org/col/latest_dwca.zip
COL_KEEP_ARCHIVE=1
# Set to 1 for a one-off forced re-download.
COL_REFRESH=0
