{
  "name": "lifecards",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LifeCards — collectible phylogenetic card game and living encyclopedia.",
  "scripts": {
    "dev": "node --watch server.mjs",
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check server.mjs && node --check src/game-engine.mjs && node --check src/database.mjs && node --check src/definitions.mjs && node --check src/taxonomy-store.mjs && node --check src/knowledge.mjs && node --check public/app.js && node --check public/radial-tree.js && node --check scripts/sync-col.mjs && node --check scripts/audit-cards.mjs && node --check scripts/repair-eukaryota.mjs && node --check scripts/debug-media.mjs && node --check scripts/reconcile-collection.mjs",
    "sync:knowledge": "node scripts/sync-knowledge.mjs",
    "sync:col": "npm run sync:eukaryota",
    "sync:col:all": "npm run sync:map",
    "prefetch:cards": "node scripts/prefetch-cards.mjs",
    "prefetch:catalog": "node scripts/prefetch-cards.mjs --catalog",
    "sync:map": "node scripts/sync-col.mjs --scope all --output ./data/life.sqlite --map-only true",
    "audit:cards": "node scripts/audit-cards.mjs",
    "audit:cards:status": "node scripts/audit-cards.mjs --status",
    "audit:cards:full": "node scripts/audit-cards.mjs --all",
    "sync:eukaryota": "node scripts/sync-col.mjs --scope Eukaryota --output ./data/eukaryota.sqlite",
    "sync:animalia": "node scripts/sync-col.mjs --scope Animalia --output ./data/animalia.sqlite",
    "repair:eukaryota": "node scripts/repair-eukaryota.mjs",
    "debug:media": "node scripts/debug-media.mjs",
    "reconcile:collection": "node scripts/reconcile-collection.mjs",
    "audit:collection": "node scripts/audit-cards.mjs --collection --limit 500",
    "audit:wikimedia": "node scripts/audit-cards.mjs --limit 1000",
    "audit:coverage": "node scripts/audit-cards.mjs --limit 1000"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "csv-parse": "^6.1.0",
    "unzipper": "^0.12.3"
  }
}
